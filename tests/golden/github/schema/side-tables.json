        ],
        [
          "table",
          "config",
          "config",
          "CREATE TABLE config (\n    id             INTEGER PRIMARY KEY CHECK (id = 1),\n    repo_allowlist TEXT    NOT NULL,\n    model          TEXT    NOT NULL,\n    bug_cap        INTEGER NOT NULL,\n    min_confidence REAL    NOT NULL\n, deny TEXT NOT NULL DEFAULT '[]', watch_mode TEXT, owned_repos TEXT NOT NULL DEFAULT '[]', publish_repos TEXT)"
        ],
        [
          "table",

# Argus settings. Copy this file to .env and fill in the values you need:
#   cp .env.example .env
# Docker compose reads .env from the project directory. For a host install
# (uv run), export the same variables in your shell or load the file yourself.
# Never commit .env.

# --- Core --------------------------------------------------------------------

# How the API and the console check callers. "token" (default) requires
# ARGUS_API_TOKEN. "proxy" trusts a reverse proxy that authenticates every
# request itself. Use proxy mode only behind such a proxy (see DEPLOY.md).
ARGUS_AUTH_MODE=token

# Shared secret for the API and the console login, at least 32 characters.
# Generate one with: openssl rand -hex 32
ARGUS_API_TOKEN=

# --- Model provider ----------------------------------------------------------
# Pick ONE block and uncomment it. With ARGUS_PROVIDER empty, Argus picks a
# provider from the credentials it finds, in this order: gateway, anthropic,
# openai, openrouter. The two CLI providers always need ARGUS_PROVIDER.
# Check the result with: uv run argus doctor

# Optional explicit choice: gateway | anthropic | openrouter | openai | claude-cli | codex-cli
# ARGUS_PROVIDER=

# OpenRouter API key. Use model ids with a slash, such as openai/gpt-6.1-sol.
# OPENROUTER_API_KEY=

# Anthropic API key.
# ANTHROPIC_API_KEY=

# OpenAI, or any OpenAI-compatible server (vLLM, Ollama, LM Studio).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# Older servers reject max_completion_tokens. Set max_tokens for them.
# ARGUS_OPENAI_TOKEN_PARAM=max_tokens

# Self-hosted Anthropic-compatible gateway. Both values are required.
# ANTHROPIC_BASE_URL=
# ANTHROPIC_AUTH_TOKEN=

# Claude Pro or Max subscription through the Claude Code CLI. Host install only.
# The Docker image does not contain the CLI.
# ARGUS_PROVIDER=claude-cli
# CLAUDE_CODE_OAUTH_TOKEN=            # from "claude setup-token", or log in with "claude"
# ARGUS_CLAUDE_CONFIG_DIR=            # optional: a separate Claude config directory
# ARGUS_CLAUDE_BIN=claude             # optional: path to the CLI binary

# ChatGPT subscription through the Codex CLI. Host install only.
# Create the home first: mkdir -p ~/.argus/codex && CODEX_HOME=~/.argus/codex codex login
# ARGUS_PROVIDER=codex-cli
# ARGUS_CODEX_HOME=/home/you/.argus/codex
# ARGUS_CODEX_BIN=codex               # optional: path to the CLI binary

# Settings for the two CLI providers.
# ARGUS_CLI_MAX_CONCURRENCY=1         # parallel CLI calls
# ARGUS_CLI_TIMEOUT=600               # seconds per CLI call

# Timeout and retries for API calls (not used by the CLI providers).
# ARGUS_LLM_TIMEOUT=300               # seconds per request
# ARGUS_LLM_MAX_RETRIES=4

# --- Model choice ------------------------------------------------------------

# Reviewer model. Empty uses the default of the selected provider.
# After you save the config screen in the console, the stored value wins over
# this variable. Change the model in the console, or with PUT /config.
# ARGUS_MODEL=

# Second attempt when a review fails on the primary model. Empty means fail.
# The API, the watcher and "argus review" all honour it. The review records
# model_used, fallback_from and fallback_reason.
# An id with a slash runs on OpenRouter. Pick a model from a different provider
# than the primary, or both fail together.
# ARGUS_FALLBACK_MODEL=

# Models the console config screen offers, comma-separated. PUT /config rejects
# a model that is not in this list, the default, or the stored model.
# ARGUS_MODEL_OPTIONS=

# --- GitHub ------------------------------------------------------------------

# Read token. Use a fine-grained token limited to the repositories you review,
# with Contents:read and Pull requests:read. Reviews fail without it.
GITHUB_TOKEN=

# Stop reading from GitHub when fewer than this many core API requests remain.
ARGUS_GITHUB_MIN_REMAINING=500

# --- PR watcher --------------------------------------------------------------
# The watcher polls GitHub and reviews new PR heads on its own. It is off by default.

# Set to 1 to start the watcher.
ARGUS_WATCH_ENABLED=
# Owners (users or organizations) whose repositories the watcher may cover,
# comma-separated. Empty means the watcher covers nothing unless you add repos
# in the console.
ARGUS_WATCH_OWNERS=
# Seconds between polls. The minimum is 30.
ARGUS_WATCH_INTERVAL=60
# Review only PRs from an OWNER, MEMBER or COLLABORATOR. Set 0 to review all
# authors. Leave at 1 for public repositories.
ARGUS_WATCH_TRUSTED_ONLY=1
# Also review draft PRs when truthy.
ARGUS_WATCH_INCLUDE_DRAFTS=
# Also review PRs from bots when truthy.
ARGUS_WATCH_INCLUDE_BOTS=
# Owners or owner/repo entries that Argus never reviews or watches. The console
# cannot remove these.
ARGUS_DENY_OWNERS=
# Only repos pushed within this many days count as active in auto mode.
ARGUS_WATCH_ACTIVE_DAYS=90
# Refresh the owner repository listing every N polls.
ARGUS_WATCH_DISCOVERY_TICKS=1
# Manual mode only: add newly found repos to the catalogue as unwatched when truthy.
ARGUS_AUTODISCOVER=
# Also review a head that was merged within the last 60 minutes. Set 0 to turn off.
ARGUS_WATCH_FAST_MERGES=1
# Park a PR head after this many failed attempts.
ARGUS_WATCH_MAX_ATTEMPTS=4

# --- Publishing (posting reviews to GitHub) ----------------------------------
# Off by default. Start with dry-run and read the stored payloads first.

# 0 = off. dry-run = render and store the review, post nothing. 1 = post.
ARGUS_PUBLISH=0
# Repositories Argus may post to, comma-separated owner/name. Empty disables
# posting, dry-run included.
ARGUS_PUBLISH_REPOS=
# Write token for posting (Pull requests:write). Use a separate bot account.
# Argus never falls back to GITHUB_TOKEN for writes.
ARGUS_PUBLISH_TOKEN=
# Login of the posting account. Empty reads it from the token.
ARGUS_PUBLISH_BOT_LOGIN=
# Lowest severity that gets an inline comment: critical | major | minor.
ARGUS_PUBLISH_MIN_SEVERITY=minor
# Inline comments per review. Extra findings go into the review summary.
ARGUS_PUBLISH_MAX_COMMENTS=4
# Reply to authors and resolve fixed threads. Needs live publishing. Set 0 to stop.
ARGUS_REPLY_LOOP=1
# Limits per collection run.
ARGUS_REPLY_MAX_WRITES_PER_RUN=20
ARGUS_RECHECK_MAX_PER_RUN=10
# Collect author outcomes every N watcher polls.
ARGUS_OUTCOME_INTERVAL_TICKS=10

# --- Review engine -----------------------------------------------------------

# Parallel review workers, from 1 to 8.
ARGUS_REVIEW_WORKERS=2
# Reclaim a review that has been running longer than this many seconds.
ARGUS_REVIEW_TIMEOUT_S=1800
# Maximum model requests in flight across reviews and judges.
ARGUS_LLM_MAX_CONCURRENCY=3
# Reviewer passes per review, from 1 to 3. More passes cost more and add few finds.
# ARGUS_REVIEW_PASSES=1
# Verifier variant. Keep "shipped" unless you run offline experiments.
ARGUS_VERIFY_VARIANT=shipped

# --- Optional lanes ----------------------------------------------------------

# Second-opinion judges (off by default). The judge comes from the model family
# that differs from the reviewer's. The URL is a full chat completions URL.
# Example with OpenRouter:
# ARGUS_JUDGE_LIVE=1
# ARGUS_JUDGE_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# ARGUS_JUDGE_ANTHROPIC_MODEL=anthropic/claude-sonnet-5-5
# ARGUS_JUDGE_ANTHROPIC_KEY=
# ARGUS_JUDGE_OPENAI_MODEL=openai/gpt-6.1-sol
# ARGUS_JUDGE_OPENAI_KEY=
ARGUS_JUDGE_LIVE=
ARGUS_JUDGE_BASE_URL=
ARGUS_JUDGE_ANTHROPIC_MODEL=
ARGUS_JUDGE_ANTHROPIC_KEY=
ARGUS_JUDGE_OPENAI_MODEL=
ARGUS_JUDGE_OPENAI_KEY=

# Linear intent lane (off by default). Argus finds a Linear issue key in the PR
# and adds the issue text to the review prompt.
LINEAR_API_KEY=
# Repositories (owner/name, comma-separated) where the lane runs.
ARGUS_LINEAR_REPOS=
# Issue key prefix, for example ENG for ENG-123.
ARGUS_LINEAR_KEY_PREFIX=

# Nightly automark judge for labelling findings (jarvis CLI on the host, off by
# default). Compose does not pass these.
# ARGUS_AUTOMARK_API_URL=http://127.0.0.1:8350
# ARGUS_AUTOMARK_JUDGE_URL=
# ARGUS_AUTOMARK_JUDGE_MODEL=
# ARGUS_AUTOMARK_JUDGE_KEY=

# Files you provide yourself. Compose does not pass these three variables. In
# Docker, mount each file read-only and set the variable under the argus-api
# environment, both in docker-compose.override.yml, pointing at the mounted path.
# JSON list of {id, summary, source} rules merged over the built-in rules.
# ARGUS_RULES_PATH=
# JSONL of known false positives to suppress. See data/fixtures/known_fps.example.jsonl.
# ARGUS_KNOWN_FPS_PATH=
# JSON list of per-repo baseline rows for the benchmark screen.
# ARGUS_BENCHMARK_BASELINES_PATH=
# JSONL of review threads from another reviewer, for the benchmark screen.
ARGUS_CR_THREADS_PATH=

# Ruff lane: rule selection and ignores (comma-separated), and the binary path.
# Compose passes only ARGUS_RUFF_RULES. Set the other two on the host or in an
# override, because an empty value would replace the built-in ignore list.
# ARGUS_RUFF_RULES=
# ARGUS_RUFF_IGNORE=
# ARGUS_RUFF_BIN=
# Config lane: rule ids to skip, comma-separated.
# ARGUS_CONFIG_IGNORE=

# --- Deploy ------------------------------------------------------------------

# Host ports for the Docker console and API, bound to 127.0.0.1. Change them when
# the defaults are taken, or to run a second copy next to this one. Give the
# second copy its own project name here (COMPOSE_PROJECT_NAME=argus-second).
ARGUS_API_PORT=8350
ARGUS_WEB_PORT=3350
# Public base URL the API advertises. Set the external URL when a reverse proxy
# fronts the API, including any path prefix. Compose defaults to
# http://127.0.0.1:$ARGUS_API_PORT, and a host install to http://127.0.0.1:8350.
# ARGUS_PUBLIC_API_URL=
# Browser origins allowed to call the API, comma-separated, no wildcard. Compose
# defaults to the console on $ARGUS_WEB_PORT.
# ARGUS_CORS_ORIGINS=
# SQLite file. Docker compose sets /data/argus.db on the argus-data volume
# itself, so leave this commented for Docker. A host install defaults to
# ./.argus/argus.db (kept out of version control). Set it only to put the file
# somewhere else.
# ARGUS_DB_PATH=./.argus/argus.db
# Token that allows GET /health?deep=1 from a non-loopback caller (optional).
# ARGUS_HEALTH_TOKEN=

# Console build settings (read at "docker compose build", baked into the web bundle).
# Browser-side API base. Empty uses the console proxy at /api/argus. Set /api/v1
# only when your reverse proxy routes that path to the API.
NEXT_PUBLIC_ARGUS_CLIENT_API=
# API address for the console's server-side calls. Compose sets this itself.
# Outside Docker, set it to your API URL, for example http://127.0.0.1:8350.
# NEXT_PUBLIC_ARGUS_API=
